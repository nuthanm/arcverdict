# Copy to .env.local. Never commit secrets.

# Market data host. Override when using a licensed vendor.
MARKET_DATA_BASE_URL=https://query1.finance.yahoo.com

# Optional vendor key. Sent as Authorization: Bearer <key> when set.
MARKET_DATA_API_KEY=

# Optional custom user agent for the data host.
MARKET_DATA_USER_AGENT=Mozilla/5.0 (compatible; ArcVerdict/1.0)

# Parallel chart requests per scan.
SCAN_CONCURRENCY=6

# Staging only. Production must leave this false so closed sessions never hit the feed.
ALLOW_CLOSED_MARKET_FETCH=false
